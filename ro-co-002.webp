.header-container{
    position:sticky;
    top:0;
    z-index:2000;
}

.topbar{

    height:40px;

    background:#6F4E37;

    color:#fff;

    overflow:hidden;

    display:flex;

    align-items:center;

}

.topbar-track{

    display:flex;

    white-space:nowrap;

    width:max-content;

    animation:marquesina 22s linear infinite;

}

.topbar-track span{

    padding-right:80px;

    font-size:.90rem;

    font-weight:500;

}

@keyframes marquesina{

from{

transform:translateX(0);

}

to{

transform:translateX(-50%);

}

}

/*=========================
HEADER 3.0
=========================*/

.topbar{

    width:100%;
    height:40px;

    background:#6F4E37;

    color:white;

    overflow:hidden;

    display:flex;

    align-items:center;

}

.topbar-track{

    display:flex;

    white-space:nowrap;

    width:max-content;

    animation:marquesina 22s linear infinite;

}

.topbar-track span{

    padding-right:80px;

}

header{

    position:sticky;

    top:0;

    z-index:1500;

    background:rgba(248,243,237,.96);

    backdrop-filter:blur(10px);

    box-shadow:0 3px 12px rgba(0,0,0,.08);

    transition:.3s;

}
.logo{
    text-align:center;
    width:100%;
}

.logo h1{
    font-family:'Playfair Display',serif;
    color:#6F4E37;
    font-size:2rem;
    margin:0 auto;
}

.logo p{
    color:#888;
    font-size:.9rem;
    margin-top:5px;
}

nav{
    margin-top:18px;

    display:flex;

    justify-content:center;

    gap:18px;

    flex-wrap:wrap;
}

nav a{

text-decoration:none;

color:#555;

font-weight:500;

transition:.3s;

}

nav a:hover{

color:#6F4E37;

}